{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "@pages/*": ["./src/pages/*"], "@fixtures": ["./src/fixtures/index.ts"], "@config/*": ["./src/config/*"], "@data/*": ["./src/data/*"], "@utils/*": ["./src/utils/*"] }
  },
  "include": ["src", "tests", "playwright.config.ts"]
}
